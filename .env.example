# =============================================================================
# Environment Variables — Oil Spill Detection System
# Copy this to .env and fill in your credentials.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Copernicus Data Space Ecosystem (Sentinel-1 SAR scenes) ---
COPERNICUS_DATASPACE_USERNAME=
COPERNICUS_DATASPACE_PASSWORD=

# --- Copernicus Marine Service / CMEMS (ocean currents) ---
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- Copernicus Climate Data Store / CDS (ERA5 wind data) ---
CDS_API_KEY=

# --- AISstream.io (optional — only for live AIS demo mode) ---
AISSTREAM_API_KEY=

# --- Mapbox (optional — only if using Mapbox GL instead of Leaflet) ---
MAPBOX_ACCESS_TOKEN=
